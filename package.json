{
  "name": "@mynameistito/codex-usage",
  "version": "1.1.5",
  "private": false,
  "description": "CLI for inspecting Codex usage windows and reset credits.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/codex-usage.git"
  },
  "bin": {
    "codex-usage": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "changeset": "changeset",
    "changeset-add": "bun run ./scripts/add-changeset.ts",
    "dev": "bun run src/cli.ts",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "lefthook install",
    "release": "bun run ./scripts/publish.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "js-yaml": "4.2.0",
    "read-yaml-file": "2.1.0"
  },
  "packageManager": "bun@1.3.14"
}
