{
  "name": "@mynameistito/codex-usage",
  "version": "2.0.0",
  "private": false,
  "description": "CLI for inspecting Codex usage windows and reset credits.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/codex-usage.git"
  },
  "bin": {
    "codex-usage": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "changeset": "changeset",
    "changeset-add": "bun run ./scripts/add-changeset.ts",
    "dev": "bun run src/cli.ts",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "lefthook install",
    "release": "bun run ./scripts/publish.ts",
    "test": "bun run build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.0.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.3"
}
